# Portal das Contas Analytics — exemplo de variáveis.
# Nunca comite um .env real. Use a Netlify UI e GitHub Secrets.

# Desligado por padrão até a Fase 3 (consentimento no frontend).
ANALYTICS_INGEST_ENABLED=false

# Neon PostgreSQL (produção) — use a URL pooled com a role de runtime.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/portal_analytics?sslmode=require

# Role com permissão de migração (owner) — usada apenas em db:migrate:prod.
# MIGRATION_DATABASE_URL=postgresql://OWNER:SENHA@HOST/portal_analytics?sslmode=require

# Banco de teste local/CI. O nome precisa conter "test".
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/portal_analytics_test
ANALYTICS_TEST_DB=1

# Segredo aleatório com pelo menos 32 bytes para HMAC do rate limiting.
RATE_LIMIT_HMAC_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes

# Origens autorizadas para o endpoint de coleta (separadas por vírgula).
ALLOWED_ORIGINS=https://portaldascontas.com.br,https://www.portaldascontas.com.br

# Opcionais
# ANALYTICS_MAX_BODY_BYTES=16384
# ANALYTICS_COUNTRY_HEADER=x-country
# DB_POOL_MAX=1
# RATE_LIMIT_IP_MAX=120
# RATE_LIMIT_IP_WINDOW_SECONDS=300
# RATE_LIMIT_VISITOR_MAX=600
# RATE_LIMIT_VISITOR_WINDOW_SECONDS=3600
# RATE_LIMIT_SESSION_MAX=60
# RATE_LIMIT_SESSION_WINDOW_SECONDS=60
# RATE_LIMIT_RETENTION_HOURS=24
