# Portal das Contas Analytics — exemplo de variáveis.
# Nunca comite um .env real. Use a Netlify UI e GitHub Secrets.

# Desligado por padrão até a Fase 3 (consentimento no frontend).
ANALYTICS_INGEST_ENABLED=false

# Neon PostgreSQL (produção) — use a URL pooled com a role de runtime.
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/portal_analytics?sslmode=require

# Role com permissão de migração (owner) — usada apenas em db:migrate:prod.
# MIGRATION_DATABASE_URL=postgresql://OWNER:SENHA@HOST/portal_analytics?sslmode=require

# Banco de teste local/CI. O nome precisa conter "test".
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/portal_analytics_test
ANALYTICS_TEST_DB=1

# Segredo aleatório com pelo menos 32 bytes para HMAC do rate limiting.
RATE_LIMIT_HMAC_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes

# Origens autorizadas para o endpoint de coleta (separadas por vírgula).
ALLOWED_ORIGINS=https://portaldascontas.com.br,https://www.portaldascontas.com.br

# Opcionais
# ANALYTICS_MAX_BODY_BYTES=16384
# ANALYTICS_COUNTRY_HEADER=x-country
# DB_POOL_MAX=1
# RATE_LIMIT_IP_MAX=120
# RATE_LIMIT_IP_WINDOW_SECONDS=300
# RATE_LIMIT_VISITOR_MAX=600
# RATE_LIMIT_VISITOR_WINDOW_SECONDS=3600
# RATE_LIMIT_SESSION_MAX=60
# RATE_LIMIT_SESSION_WINDOW_SECONDS=60
# RATE_LIMIT_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Fase 4 - captura HTML no edge (planejada/implementada localmente)
# Mantenha as duas flags de captura e analytics em false fora de teste.
# ---------------------------------------------------------------------------
EDGE_CAPTURE_ENABLED=false
EDGE_ANALYTICS_ENABLED=false
EDGE_SECURITY_ENABLED=false
EDGE_INGEST_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes
EDGE_INGEST_KEY_ID=v1
EDGE_ANALYTICS_SAMPLE_RATE=0.1
# Timeout do envio Edge -> Function. Faixa aceita: 250 a 5000 ms.
# EDGE_CAPTURE_TIMEOUT_MS=2000

# Opcionais
# O limite de corpo é fixo em 8192 bytes e compartilhado por Edge e Function.
# EDGE_CAPTURE_MAX_EVENTS_DAY=25000
# EDGE_CAPTURE_TIMESTAMP_WINDOW_SECONDS=60
# EDGE_CAPTURE_NONCE_TTL_SECONDS=600
# EDGE_RATE_MAX=120
# EDGE_RATE_WINDOW_SECONDS=300
# EDGE_CAPTURE_RAW_RETENTION_DAYS=7
# EDGE_CAPTURE_AGGREGATE_RETENTION_DAYS=90
# EDGE_CAPTURE_INDICATOR_RETENTION_MONTHS=13
# EDGE_CAPTURE_NONCE_RETENTION_HOURS=24
# EDGE_CAPTURE_RATE_RETENTION_HOURS=24

# Limpeza agendada da Fase 4 (scheduled function). Desligada por padr�o.
HTML_CAPTURE_CLEANUP_ENABLED=false
# EDGE_CAPTURE_COUNTER_RETENTION_DAYS=90

# Role exclusiva analytics_cleanup para limpeza agendada (n�o usar a role de runtime sem DELETE).
# CLEANUP_DATABASE_URL=postgresql://analytics_cleanup:SENHA@HOST/portal_analytics?sslmode=require
